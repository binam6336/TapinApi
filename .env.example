; Copy this file to .env in the directory that contains index.php.
; Use the full URL of that directory, with a trailing slash.
BASE_URL=https://example.com/tapin/test/

; Use the database name and username shown in your hosting panel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tapin_api
DB_USER=tapin_api
DB_PASS=""
DB_TIMEZONE=+03:30

; Keep your existing key if you have saved connections.
; For a new install: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
DATABASE_KEY=""
DASHBOARD_USER=admin
; Leave empty to open the dashboard and its API without login.
; To enable login, choose a password of at least 12 characters.
DASHBOARD_PASSWORD=""
